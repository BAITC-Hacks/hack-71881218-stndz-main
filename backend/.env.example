# Local Ollama: no real API key or external provider is needed.
# Copy this file to backend/.env after installing Ollama and creating the model.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=moneygraph-qwen3:4b
LLM_API_KEY=
# Total time budget for one question, including all planning rounds.
LLM_TIMEOUT_SECONDS=60
